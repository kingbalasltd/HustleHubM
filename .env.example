# Copy this file to .env and change what you need.
# Everything here is optional - the app works without a .env file.

# Local AI (Ollama). Use any model you have pulled with `ollama pull`.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434

# Optional: Google Places finds businesses that have NO website
# (the best leads for a website offer) plus their phone numbers.
# Get a key at https://console.cloud.google.com (Places API (New)).
# Google gives free monthly credit, but it is a paid API - set a budget alert.
GOOGLE_PLACES_API_KEY=

# Defaults for the Settings page (you can also change them in the app).
SENDER_NAME=
SENDER_COMPANY=HustleHubM
SENDER_CONTACT=
DAILY_SEND_LIMIT=20
DEFAULT_COUNTRY_CODE=27

# Web app
PORT=5000
FLASK_DEBUG=0
